---
import { BRAND, type Locale } from '../i18n/config';
import type { PageKey } from '../i18n/pages';
import Base from './Base.astro';
import { PARTNER_COPY } from '../i18n/partner';
import ContactForm from '../components/ContactForm.astro';
import CaseCards from '../components/CaseCards.astro';
import { approvedPortfolio, approvedTeam } from '../lib/approved-content';
interface Props { locale: Locale; page: PageKey; }
const { locale, page } = Astro.props;
const c = PARTNER_COPY[locale];
const hero = c.pages[page as keyof typeof c.pages] ?? c.pages.partner;
const portfolio=approvedPortfolio();
const proof=Array.isArray(portfolio?.proof?.[locale]) ? portfolio.proof[locale].filter((value:unknown)=>typeof value==='string') : [];
const team=approvedTeam();
const hasForm=['home','contact','partner'].includes(page);
const visual=['home','partner'].includes(page);
const discussionUrl=hasForm ? '#partner-form' : `/${locale}/contact/`;
---
<Base locale={locale} page={page}>
  <section class="border-b border-[#e2e5eb] bg-[#0b1930] text-white">
    <div class:list={["container-page grid items-center gap-10 py-16 sm:py-24",visual && "lg:grid-cols-[1.4fr_1fr]"]}>
      <div>
        <p class="text-sm font-medium text-slate-300">{c.eyebrow}</p>
        <h1 class="mt-5 max-w-4xl text-white">{hero.title}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-200">{hero.summary}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          {page==='home' ? <>
            <a class="btn-primary" data-partner-cta="experience" href={`/${locale}/projects/`}>{c.experienceCta}</a>
            <a class="btn-outline" data-partner-cta="discussion" href={discussionUrl}>{c.primary}</a>
          </> : <>
            <a class="btn-primary" data-partner-cta="discussion" href={discussionUrl}>{c.primary}</a>
            <a class="btn-outline" data-partner-cta="brief" href={`/${locale}/contact/#capability-request`}>{c.brief}</a>
          </>}
        </div>
      </div>
      {visual && <figure class="overflow-hidden border border-slate-600">
        <img src="/brand/partner-workflow-1280.webp" srcset="/brand/partner-workflow-480.webp 480w, /brand/partner-workflow-768.webp 768w, /brand/partner-workflow-1280.webp 1280w" sizes="(min-width:1024px) 50vw, 100vw" alt={c.visualAlt} width="1280" height="800" fetchpriority="high" class="h-auto w-full" />
        <figcaption class="border-t border-slate-600 p-4 text-sm text-slate-200">{c.illustrative}</figcaption>
      </figure>}
    </div>
  </section>
  {page==='home' && proof.length>0 && <section class="border-b border-[#e2e5eb] bg-white py-6"><ul class="container-page flex flex-wrap gap-8">{proof.map((fact:string)=><li class="font-semibold">{fact}</li>)}</ul></section>}
  {page==='about' && <section class="section"><div class="container-page grid gap-8 md:grid-cols-2">
    <article><h2>{c.aboutDubaiTitle}</h2><p class="mt-4">{c.aboutDubaiText}</p></article>
    <article><h2>{c.aboutTeamTitle}</h2><p class="mt-4">{c.aboutTeamText}</p></article>
    <p class="text-sm md:col-span-2">{c.authorityNote}</p>
    <p class="text-sm md:col-span-2">{c.footerPrefix} {c.legalBoundary}</p>
  </div></section>}
  {page==='partner' && <section class="section">
    <div class="container-page max-w-4xl">
      <h2>{c.problemTitle}</h2>
      <p class="mt-5 max-w-3xl text-[#475569]">{c.problem}</p>
    </div>
  </section>}
  {['home','partner'].includes(page) && <section class="section border-y border-[#e2e5eb] bg-white">
    <div class="container-page">
      <h2>{c.processTitle}</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        {c.steps.map((step, index) => <li>
          <span class="inline-flex h-10 w-10 items-center justify-center border border-[#e2e5eb] font-semibold" aria-hidden="true">{index + 1}</span>
          <h3 class="mt-4">{step.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-[#475569]">{step.text}</p>
        </li>)}
      </ol>
      {page==='partner' && <div><h3 class="mt-12">{c.rolesTitle}</h3>
      <table class="mt-5 w-full table-fixed border-collapse text-start text-sm">
        <caption class="sr-only">{c.rolesTitle}</caption>
        <thead><tr>{c.roleHeadings.map(label => <th scope="col" class="break-words border border-[#e2e5eb] bg-[#eaf0f7] p-3 text-start">{label}</th>)}</tr></thead>
        <tbody>{c.roles.map(row => <tr>{row.map((value,index) => index === 0
          ? <th scope="row" class="break-words border border-[#e2e5eb] p-3 text-start align-top">{value}</th>
          : <td class="break-words border border-[#e2e5eb] p-3 align-top text-[#475569]">{value}</td>)}</tr>)}</tbody>
      </table></div>}
    </div>
  </section>}
  {['home','services'].includes(page) && <section class="section border-y border-[#e2e5eb] bg-white">
    <div class="container-page">
      <p class="category-tag">{c.possible}</p>
      <h2 class="mt-3">{c.possibleTitle}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {c.capabilities.map((item,index) => <article class="card"><h3>{item.title}</h3>
          {index===3 && <p class="category-tag mt-3">{c.possible}</p>}
          <p class="mt-3 text-[#475569]">{item.text}</p>
          {Array.isArray(portfolio?.systems?.[index]?.[locale]) && <ul class="mt-4 list-disc space-y-2 ps-5">{portfolio.systems[index][locale].filter((value:unknown)=>typeof value==='string').map((value:string)=><li>{value}</li>)}</ul>}
        </article>)}
      </div>
      <p class="mt-6 text-sm text-[#475569]">{c.deliverablesNote}</p>
      <p class="mt-6 max-w-3xl font-medium">{c.authorityNote}</p>
      <p class="mt-3 max-w-3xl text-sm text-[#475569]">{c.accreditationNote}</p>
    </div>
  </section>}
  {['home','projects'].includes(page) && <section class="section" id="team-experience">
    <div class="container-page">
      <p class="category-tag">{c.done}</p>
      <h2 class="mt-3">{c.doneTitle}</h2>
      <CaseCards locale={locale} />
    </div>
  </section>}
  {page==='home' && <section class="section">
    <div class="container-page">
      <h2>{c.benefitsTitle}</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {c.benefits.map(item => <article><h3>{item.title}</h3><p class="mt-3 text-[#475569]">{item.text}</p></article>)}
      </div>
    </div>
  </section>}
  {['home','about'].includes(page) && team.length>0 && <section class="section border-y border-[#e2e5eb] bg-white"><div class="container-page"><h2>{c.teamTitle}</h2><div class="mt-8 grid gap-8 md:grid-cols-3">{team.map(person=><article><h3>{person.name}</h3><p class="mt-3">{person.roles[locale]}</p></article>)}</div></div></section>}
  {page==='partner' && <section class="section border-y border-[#e2e5eb] bg-[#eaf0f7]">
    <div class="container-page max-w-4xl">
      <p class="category-tag">{c.held}</p>
      <h2 class="mt-3">{c.exclusionsTitle}</h2>
      <ul class="mt-6 list-disc space-y-3 ps-6">{c.exclusions.map(text => <li>{text}</li>)}</ul>
    </div>
  </section>}
  {page==='contact' && <section class="section"><dl class="container-page grid gap-8 md:grid-cols-3">
    <div><dt class="font-semibold">{c.emailLabel}</dt><dd class="mt-2"><a dir="ltr" class="underline" href={`mailto:${BRAND.email}`}>{BRAND.email}</a></dd></div>
    <div><dt class="font-semibold">{c.phoneLabel}</dt><dd class="mt-2"><a dir="ltr" class="underline" href={`tel:${BRAND.phone}`}>{BRAND.phone}</a></dd></div>
    <div><dt class="font-semibold">{c.location}</dt><dd class="mt-2">{BRAND.address[locale]}</dd></div>
  </dl></section>}
  {hasForm && <section class="section" id="partner-form">
    <div class="container-page max-w-4xl">
      <h2>{c.form.title}</h2>
      <p class="mt-4 text-[#475569]">{c.form.intro}</p>
      <div class="mt-8"><ContactForm locale={locale} /></div>
    </div>
  </section>}
</Base>
