---
import type { Locale } from '../i18n/config';
import { BRAND } from '../i18n/config';
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { PAGES } from '../i18n/pages';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(BRAND.mapsQuery)}&output=embed`;
---

<Base locale={locale} page="contact">
  <PageHero eyebrow={PAGES.contact[locale].label} title={PAGES.contact[locale].title} subtitle={PAGES.contact[locale].description} />
  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl">{PAGES.contact[locale].label}</h2>
        <p class="mt-2 text-brand-600">{BRAND.address[locale]}</p>
        <ul class="mt-4 space-y-1 text-sm text-brand-700">
          <li><a href={`mailto:${BRAND.email}`} class="hover:underline">{BRAND.email}</a></li>
          <li><a href={`tel:${BRAND.phone}`} dir="ltr" class="hover:underline">{BRAND.phone}</a></li>
        </ul>
        <div class="mt-8">
          <ContactForm locale={locale} />
        </div>
      </div>
      <div class="overflow-hidden rounded-lg border border-brand-100">
        <iframe
          title="Map"
          src={mapEmbed}
          width="100%"
          height="100%"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="min-h-[400px]"
        ></iframe>
      </div>
    </div>
  </section>
</Base>
