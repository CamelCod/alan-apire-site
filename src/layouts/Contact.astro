---
import type { Locale } from '../i18n/config';
import { BRAND } from '../i18n/config';
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { PAGES } from '../i18n/pages';
import { CONTACT_COPY } from '../i18n/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(BRAND.mapsQuery)}&output=embed`;
---

<Base locale={locale} page="contact">
  <link slot="head" rel="preconnect" href="https://www.google.com" />
  <link slot="head" rel="preconnect" href="https://formspree.io" />
  <PageHero eyebrow={PAGES.contact[locale].label} title={CONTACT_COPY.heading[locale]} subtitle={CONTACT_COPY.intro[locale]} />
  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl">{CONTACT_COPY.detailsHeading[locale]}</h2>
        <p class="mt-2 font-semibold text-brand-800">{BRAND.name}</p>
        <p class="mt-1 text-brand-600">{BRAND.address[locale]}</p>
        <ul class="mt-4 space-y-1 text-sm text-brand-700">
          <li><a href={`mailto:${BRAND.email}`} class="hover:underline">{BRAND.email}</a></li>
          <li><a href={`tel:${BRAND.phone}`} dir="ltr" class="hover:underline">{BRAND.phone}</a></li>
        </ul>
        <div class="mt-8">
          <ContactForm locale={locale} />
        </div>
      </div>
      <div class="overflow-hidden rounded-lg border border-brand-100">
        <iframe
          title="Alan Apire office location map"
          src={mapEmbed}
          width="100%"
          height="450"
          loading="lazy"
          referrerpolicy="strict-origin"
          class="min-h-[400px] h-full block"
        ></iframe>
      </div>
    </div>
  </section>
</Base>
