---
import type { Locale } from '../i18n/config';
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import { PAGES } from '../i18n/pages';
import { PROJECTS_COPY } from '../i18n/site';
import { getCollection } from 'astro:content';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const readCaseLabel = locale === 'ar' ? 'التفاصيل' : locale === 'ru' ? 'Подробнее' : 'Read case';
// Only verified case studies (order 1-3) are published; placeholders carry order 99.
const all = await getCollection('projects', (e) => e.data.locale === locale && e.data.order < 99);
const projects = all.sort((a, b) => a.data.order - b.data.order);
---

<Base locale={locale} page="projects">
  <PageHero eyebrow={PAGES.projects[locale].label} title={PAGES.projects[locale].title} subtitle={PAGES.projects[locale].description} />
  <section class="section">
    <div class="container-page">
      <p class="mb-8 max-w-3xl rounded-lg border border-brand-100 bg-brand-50 p-4 text-sm text-brand-600">
        {PROJECTS_COPY.notice[locale]}
      </p>
    </div>
    <div class="container-page grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <article class="card flex flex-col overflow-hidden">
          {p.data.cover && (
            <a href={`/${locale}/projects/${p.slug}`} aria-label={readCaseLabel} class="mb-4 -mx-6 -mt-6 block aspect-video overflow-hidden bg-brand-100">
              <img src={p.data.cover.src} alt={p.data.title} width={p.data.cover.width} height={p.data.cover.height} class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" />
            </a>
          )}
          <h3 class="text-lg">{p.data.title}</h3>
          {p.data.sector && <p class="mt-1 text-xs font-semibold uppercase tracking-widest text-accent">{p.data.sector}</p>}
          <p class="mt-2 flex-1 text-sm text-brand-600">{p.data.summary}</p>
          <a href={`/${locale}/projects/${p.slug}`} class="mt-4 text-sm font-semibold text-brand-700 hover:underline">{readCaseLabel}</a>
        </article>
      ))}
      {projects.length === 0 && (
        <p class="text-brand-500">Project case studies will appear here once Phase 5 content is delivered.</p>
      )}
    </div>
  </section>
</Base>
