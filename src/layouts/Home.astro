---
import type { Locale } from '../i18n/config';
import Base from './Base.astro';
import AnimatedHero from '../components/AnimatedHero.astro';
import { localizedPath } from '../i18n/pages';
import { HOME, PILLARS, SECTOR_LABELS, STAGES } from '../i18n/site';
import { getCollection } from 'astro:content';

interface Props { locale: Locale; }
const { locale } = Astro.props;

const H = {
  heroEyebrow: HOME.hero.eyebrow[locale],
  heroHeadline: HOME.hero.headline[locale],
  heroSub: HOME.hero.sub[locale],
  primaryCta: HOME.hero.primaryCta[locale],
  secondaryCta: HOME.hero.secondaryCta[locale],
  pillarsHeading: HOME.pillarsHeading[locale],
  sectorsHeading: HOME.sectorsHeading[locale],
  featuredHeading: HOME.featuredHeading[locale],
  approachHeading: HOME.approachHeading[locale],
  whyHeading: HOME.whyHeading[locale],
  ctaHeadline: HOME.cta.headline[locale],
  ctaSub: HOME.cta.sub[locale],
  ctaButton: HOME.cta.button[locale],
};

const pillars = PILLARS[locale];
const sectorLabels = SECTOR_LABELS[locale];
const stages = STAGES[locale];
const why = HOME.why[locale];

const featured = (await getCollection('projects', (e) => e.data.locale === locale && e.data.order < 99))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const readCaseLabel = locale === 'ar' ? 'اقرأ الحالة' : locale === 'ru' ? 'Читать кейс' : 'Read case';
---

<Base locale={locale} page="home">
  <AnimatedHero
    eyebrow={H.heroEyebrow}
    title={H.heroHeadline}
    subtitle={H.heroSub}
    primaryLabel={H.primaryCta}
    primaryHref={localizedPath(locale, 'contact')}
    secondaryLabel={H.secondaryCta}
    secondaryHref={localizedPath(locale, 'projects')}
    backgroundImage="/brand/power-plant-hero.jpg"
  />

  {/* Capability Strip — the 4 pillars */}
  <section class="section">
    <div class="container-page">
      <h2 class="text-2xl sm:text-3xl">{H.pillarsHeading}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {pillars.map((p, i) => (
          <div class="card">
            <p class="eyebrow text-accent">0{i + 1}</p>
            <h3 class="mt-2 text-lg">{p.title}</h3>
            <p class="mt-2 text-sm text-brand-600">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Target sectors strip */}
  <section class="border-y border-brand-100 bg-brand-50">
    <div class="container-page py-8">
      <p class="eyebrow text-brand-500">{H.sectorsHeading}</p>
      <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-2 text-sm font-semibold text-brand-800">
        {sectorLabels.map((s) => <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>{s}</li>)}
      </ul>
    </div>
  </section>

  {/* Featured projects — team track record */}
  <section class="section" id="projects">
    <div class="container-page">
      <h2 class="text-2xl sm:text-3xl">{H.featuredHeading}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {featured.map((p) => (
          <article class="card flex flex-col overflow-hidden">
            {p.data.cover && (
              <div class="mb-4 -mx-6 -mt-6 aspect-video overflow-hidden bg-brand-100">
                <img src={p.data.cover.src} alt={p.data.title} class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" />
              </div>
            )}
            {p.data.sector && <p class="text-xs font-semibold uppercase tracking-widest text-accent">{p.data.sector}</p>}
            <h3 class="mt-2 text-lg">{p.data.title}</h3>
            {(p.data.location || p.data.year) && (
              <p class="mt-1 text-xs text-brand-500">{[p.data.location, p.data.year].filter(Boolean).join(' · ')}</p>
            )}
            <p class="mt-3 flex-1 text-sm text-brand-600">{p.data.summary}</p>
            <a href={`/${locale}/projects/${p.slug}`} class="mt-4 text-sm font-semibold text-brand-700 hover:underline">{readCaseLabel}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* 5-stage operating framework */}
  <section class="section bg-brand-50">
    <div class="container-page">
      <h2 class="text-2xl sm:text-3xl">{H.approachHeading}</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {stages.map((s) => (
          <li class="card">
            <p class="font-serif text-2xl font-bold text-accent">{s.num}</p>
            <h3 class="mt-2 text-base font-semibold text-brand-900">{s.title}</h3>
            <p class="mt-1 text-sm text-brand-600">{s.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* Why choose us */}
  <section class="section">
    <div class="container-page">
      <h2 class="text-2xl sm:text-3xl">{H.whyHeading}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {why.map((w) => (
          <div class="card">
            <h3 class="text-lg">{w.title}</h3>
            <p class="mt-2 text-sm text-brand-600">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Final CTA */}
  <section class="bg-brand-950 text-white">
    <div class="container-page section flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl sm:text-3xl text-white">{H.ctaHeadline}</h2>
        <p class="mt-2 text-brand-200">{H.ctaSub}</p>
      </div>
      <a href={localizedPath(locale, 'contact')} class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 font-semibold text-brand-950 transition-all hover:bg-accent-light hover:shadow-lg">{H.ctaButton}</a>
    </div>
  </section>
</Base>
