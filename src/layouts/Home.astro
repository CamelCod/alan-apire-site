---
import type { Locale } from '../i18n/config';
import Base from './Base.astro';
import AnimatedHero from '../components/AnimatedHero.astro';
import { localizedPath } from '../i18n/pages';
import { HOME, PILLARS, SECTOR_LABELS, STAGES } from '../i18n/site';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

interface Props { locale: Locale; }
const { locale } = Astro.props;

const H = {
  heroEyebrow: HOME.hero.eyebrow[locale],
  heroHeadline: HOME.hero.headline[locale],
  heroSub: HOME.hero.sub[locale],
  primaryCta: HOME.hero.primaryCta[locale],
  secondaryCta: HOME.hero.secondaryCta[locale],
  pillarsHeading: HOME.pillarsHeading[locale],
  pillarsIntro: HOME.pillarsIntro[locale],
  sectorsHeading: HOME.sectorsHeading[locale],
  sectorsIntro: HOME.sectorsIntro[locale],
  featuredHeading: HOME.featuredHeading[locale],
  featuredIntro: HOME.featuredIntro[locale],
  approachHeading: HOME.approachHeading[locale],
  approachIntro: HOME.approachIntro[locale],
  whyHeading: HOME.whyHeading[locale],
  ctaHeadline: HOME.cta.headline[locale],
  ctaSub: HOME.cta.sub[locale],
  ctaButton: HOME.cta.button[locale],
  trustHeading: HOME.trust.heading[locale],
  trustIntro: HOME.trust.intro[locale],
  trustCredentials: HOME.trust.credentials[locale],
};

const pillars = PILLARS[locale];
const sectorLabels = SECTOR_LABELS[locale];
const stages = STAGES[locale];

// 3 featured case studies ordered 0..2
const featured = (await getCollection('projects', (e) => e.data.locale === locale && e.data.order < 99))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const readCaseLabel = locale === 'ar' ? 'عرض الحالة' : locale === 'ru' ? 'Смотреть кейс' : 'View case';
---

<Base locale={locale} page="home">
  <AnimatedHero
    eyebrow={H.heroEyebrow}
    title={H.heroHeadline}
    subtitle={H.heroSub}
    primaryLabel={H.primaryCta}
    primaryHref={localizedPath(locale, 'contact')}
    secondaryLabel={H.secondaryCta}
    secondaryHref={localizedPath(locale, 'projects')}
    backgroundImage="/brand/power-plant-hero.webp"
  />

  {/* Service Pillars — 4 Licensed Service Areas */}
  <section class="section border-b border-[#e2e5eb] bg-[#faf9f6]">
    <div class="container-page">
      <div class="max-w-3xl">
        <p class="category-tag">{locale === 'ar' ? 'الخدمات المرخصة' : locale === 'ru' ? 'ЛИЦЕНЗИРОВАННЫЕ УСЛУГИ' : 'LICENSED SERVICES'}</p>
        <h2 class="mt-2 text-2xl sm:text-3xl text-[#0b1930]">{H.pillarsHeading}</h2>
        <p class="mt-4 text-[#475569]">{H.pillarsIntro}</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {pillars.map((p, i) => (
          <article class="card flex flex-col justify-between">
            <div>
              <p class="text-xs font-mono font-medium text-[#64748b]">0{i + 1}</p>
              <h3 class="mt-3 text-lg font-semibold text-[#0b1930]">{p.title}</h3>
              <p class="mt-2 text-xs font-medium text-[#0b4ea2]">{p.tagline}</p>
              <p class="mt-3 text-sm leading-relaxed text-[#475569]">{p.desc}</p>
            </div>
            <ul class="mt-6 border-t border-[#e2e5eb] pt-4 space-y-1.5 text-xs text-[#334155]">
              {p.scope.slice(0, 3).map((item) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-[#0b4ea2] mt-0.5">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Target Sectors Strip */}
  <section class="border-b border-[#e2e5eb] bg-white py-12">
    <div class="container-page">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div class="max-w-xl">
          <p class="category-tag">{locale === 'ar' ? 'القطاعات الصناعية' : locale === 'ru' ? 'ПРОМЫШЛЕННЫЕ ОТРАСЛИ' : 'INDUSTRIAL SECTORS'}</p>
          <h2 class="mt-1 text-xl sm:text-2xl text-[#0b1930]">{H.sectorsHeading}</h2>
          <p class="mt-2 text-sm text-[#475569]">{H.sectorsIntro}</p>
        </div>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-[#0b1930]">
          {sectorLabels.map((s) => (
            <li class="flex items-center gap-2 border border-[#e2e5eb] bg-[#faf9f6] px-3.5 py-1.5">
              <span class="h-1.5 w-1.5 bg-[#0b4ea2]"></span>
              {s}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* Premium Project References Section — in the spirit of aecom.com */}
  <section class="section border-b border-[#e2e5eb] bg-[#faf9f6]" id="projects">
    <div class="container-page">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div class="max-w-2xl">
          <p class="category-tag">{locale === 'ar' ? 'سجل الأعمال المرجعي' : locale === 'ru' ? 'ИНЖЕНЕРНЫЕ РЕФЕРЕНСЫ' : 'PROJECT REFERENCES'}</p>
          <h2 class="mt-2 text-2xl sm:text-3xl text-[#0b1930]">{H.featuredHeading}</h2>
          <p class="mt-3 text-sm leading-relaxed text-[#475569]">{H.featuredIntro}</p>
        </div>
        <a href={localizedPath(locale, 'projects')} class="text-sm font-semibold text-[#0b4ea2] hover:text-[#083c7d] flex items-center gap-1.5 shrink-0">
          <span>{locale === 'ar' ? 'جميع المشاريع' : locale === 'ru' ? 'Все проекты' : 'All projects'}</span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1 rtl:rotate-180">→</span>
        </a>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {featured.map((p) => (
          <article class="card flex flex-col justify-between overflow-hidden p-0 group">
            {/* 16:10 Card Image Area */}
            {p.data.cover ? (
              <a href={`/${locale}/projects/${p.slug}`} aria-label={readCaseLabel} class="block aspect-[16/10] overflow-hidden bg-[#faf9f6] border-b border-[#e2e5eb]">
                <Image
                  src={p.data.cover}
                  alt={p.data.title}
                  format="webp"
                  quality={80}
                  loading="lazy"
                  class="h-full w-full object-cover transition-colors duration-200"
                />
              </a>
            ) : (
              /* Deliberate Text-Led Layout for Missing Asset */
              <div class="aspect-[16/10] p-6 flex flex-col justify-between bg-[#faf9f6] border-b border-[#e2e5eb]">
                <div>
                  <p class="category-tag">{p.data.editorialLabel ?? p.data.sector}</p>
                  <p class="mt-3 text-2xl font-bold tracking-tight text-[#0b1930]">
                    {p.data.figures?.[0] ?? 'DN300 PE'}
                  </p>
                  <p class="text-xs text-[#64748b] mt-1">
                    {p.data.figures?.slice(1).join(' · ') ?? '8.4 km · 2.4 bar'}
                  </p>
                </div>
                <p class="text-[0.7rem] text-[#94a3b8] italic">
                  {p.data.missingAssetNote ?? (locale === 'ar' ? 'الأصل المطلوب: مخطط المسار' : locale === 'ru' ? 'Требуемый материал: трассировка сетей' : 'Asset required: Route alignment drawing')}
                </p>
              </div>
            )}

            <div class="p-6 flex flex-col flex-1 justify-between">
              <div>
                {/* Small category/location label above headline */}
                <p class="category-tag text-[0.7rem]">{p.data.editorialLabel ?? p.data.sector}</p>
                {/* Plain one-line headline */}
                <h3 class="mt-2 text-base font-semibold leading-snug text-[#0b1930] line-clamp-1">
                  <a href={`/${locale}/projects/${p.slug}`} class="hover:text-[#0b4ea2]">
                    {p.data.title}
                  </a>
                </h3>
                {/* One support line with team's contribution */}
                <p class="mt-2 text-xs leading-relaxed text-[#64748b] line-clamp-2">
                  {p.data.supportLine ?? p.data.summary}
                </p>
              </div>

              <div class="mt-6 border-t border-[#e2e5eb] pt-4">
                {/* Three key figures in a quiet row */}
                {p.data.figures && p.data.figures.length > 0 && (
                  <div class="grid grid-cols-3 gap-2 text-center text-xs text-[#334155] border-b border-[#e2e5eb] pb-3 mb-3">
                    {p.data.figures.slice(0, 3).map((fig) => (
                      <span class="font-medium truncate">{fig}</span>
                    ))}
                  </div>
                )}
                {/* Text link "View case" with arrow, subtle color hover */}
                <a
                  href={`/${locale}/projects/${p.slug}`}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0b4ea2] hover:text-[#083c7d] transition-colors"
                >
                  <span>{readCaseLabel}</span>
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1 rtl:rotate-180">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Technical Credentials & Authoritative Licensing */}
  <section class="section border-b border-[#e2e5eb] bg-white">
    <div class="container-page">
      <div class="max-w-3xl">
        <p class="category-tag">{locale === 'ar' ? 'التراخيص والاعتمادات' : locale === 'ru' ? 'ЛИЦЕНЗИИ И РЕЕСТРЫ' : 'LICENSING & CREDENTIALS'}</p>
        <h2 class="mt-2 text-2xl sm:text-3xl text-[#0b1930]">{H.trustHeading}</h2>
        <p class="mt-4 text-[#475569]">{H.trustIntro}</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {H.trustCredentials.map((c) => (
          <div class="card">
            <p class="category-tag text-[0.7rem] text-[#0b4ea2]">{c.label}</p>
            <h3 class="mt-2 text-base font-semibold text-[#0b1930]">{c.value}</h3>
            <p class="mt-2 text-xs leading-relaxed text-[#475569]">{c.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 5-Stage Delivery Method */}
  <section class="section border-b border-[#e2e5eb] bg-[#faf9f6]">
    <div class="container-page">
      <div class="max-w-3xl">
        <p class="category-tag">{locale === 'ar' ? 'منهجية العمل' : locale === 'ru' ? 'МЕТОДОЛОГИЯ РЕАЛИЗАЦИИ' : 'DELIVERY METHOD'}</p>
        <h2 class="mt-2 text-2xl sm:text-3xl text-[#0b1930]">{H.approachHeading}</h2>
        <p class="mt-4 text-[#475569]">{H.approachIntro}</p>
      </div>
      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {stages.map((s) => (
          <li class="card">
            <p class="text-sm font-mono font-semibold text-[#0b4ea2]">{s.num}</p>
            <h3 class="mt-2 text-base font-semibold text-[#0b1930]">{s.title}</h3>
            <p class="mt-2 text-xs leading-relaxed text-[#475569]">{s.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* Clean Action CTA — No 48-hour promise */}
  <section class="bg-[#0b1930] py-16 text-white">
    <div class="container-page flex flex-col md:flex-row md:items-center md:justify-between gap-8">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl font-semibold text-white">{H.ctaHeadline}</h2>
        <p class="mt-3 text-sm text-slate-300 leading-relaxed">{H.ctaSub}</p>
      </div>
      <a href={localizedPath(locale, 'contact')} class="btn-primary shrink-0 self-start md:self-center">
        {H.ctaButton}
      </a>
    </div>
  </section>
</Base>
