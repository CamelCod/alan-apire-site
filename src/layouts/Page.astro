---
import type { Locale } from '../i18n/config';
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import PartnerSite from './PartnerSite.astro';
import { PAGES, type PageKey } from '../i18n/pages';
interface Props { locale: Locale; page: PageKey; }
const { locale, page } = Astro.props;
const t = PAGES[page][locale];
const isPolicy = page === 'privacy' || page === 'terms';
if (['team','careers'].includes(page)) return Astro.redirect(`/${locale}/about/`,301);
if (page === 'industries') return Astro.redirect(`/${locale}/services/`,301);
---
{isPolicy ? <Base locale={locale} page={page}>
  <PageHero eyebrow={t.label} title={t.title} subtitle={t.description} />
  <section class="section">
    <div class="container-page prose-tight max-w-3xl"><p>{t.description}</p></div>
  </section>
</Base> : <PartnerSite locale={locale} page={page} />}
