---
import type { Locale } from '../i18n/config';
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import { PAGES, localizedPath, type PageKey } from '../i18n/pages';
import { ABOUT, PILLARS, SECTORS, INDUSTRIES_COPY, CTA_LABEL } from '../i18n/site';
import en from '../content/i18n/en.json';
import ar from '../content/i18n/ar.json';
import ru from '../content/i18n/ru.json';

const I18N = { en, ar, ru } as const;

interface Props { locale: Locale; page: PageKey; }
const { locale, page } = Astro.props;
const t = PAGES[page][locale];

const pillars = PILLARS[locale];
const sectors = SECTORS[locale];

const aboutCopy = page === 'about' ? {
  positioning: ABOUT.positioning[locale],
  profile: ABOUT.profile[locale],
  corpHeading: ABOUT.corpHeading[locale],
  legalEntityLabel: ABOUT.legalEntityLabel[locale],
  legalEntity: ABOUT.legalEntity,
  jurisdictionLabel: ABOUT.jurisdictionLabel[locale],
  jurisdiction: ABOUT.jurisdiction[locale],
  licensedLabel: ABOUT.licensedLabel[locale],
  licensed: ABOUT.licensed[locale],
  operatingHeading: ABOUT.operatingHeading[locale],
  operating: ABOUT.operating[locale],
} : null;

const teamMembers = I18N[locale].team.members;
---

<Base locale={locale} page={page}>
  <PageHero eyebrow={t.label} title={t.title} subtitle={t.description} />

  {page === 'about' && aboutCopy && (
    <section class="section">
      <div class="container-page max-w-4xl">
        <h2 class="text-2xl font-semibold text-[#0b1930] sm:text-3xl leading-snug">{aboutCopy.positioning}</h2>
        {aboutCopy.profile.map((p) => <p class="mt-6 text-base leading-relaxed text-[#334155]">{p}</p>)}

        <div class="mt-12 border border-[#e2e5eb] bg-white p-6 sm:p-8">
          <p class="category-tag text-xs font-semibold text-[#64748b]">{locale === 'ar' ? 'بيانات التسجيل المؤسسي' : locale === 'ru' ? 'РЕГИСТРАЦИОННЫЕ ДАННЫЕ' : 'CORPORATE REGISTRATION'}</p>
          <h3 class="mt-2 text-xl font-semibold text-[#0b1930]">{aboutCopy.corpHeading}</h3>
          <dl class="mt-6 space-y-5 text-sm">
            <div>
              <dt class="category-tag text-[0.7rem]">{aboutCopy.legalEntityLabel}</dt>
              <dd class="mt-1 font-semibold text-[#0b1930]">{aboutCopy.legalEntity}</dd>
            </div>
            <div>
              <dt class="category-tag text-[0.7rem]">{aboutCopy.jurisdictionLabel}</dt>
              <dd class="mt-1 font-semibold text-[#0b1930]">{aboutCopy.jurisdiction}</dd>
            </div>
            <div>
              <dt class="category-tag text-[0.7rem]">{aboutCopy.licensedLabel}</dt>
              <dd class="mt-1">
                <ol class="list-decimal space-y-1 ps-5 font-semibold text-[#0b1930]">
                  {aboutCopy.licensed.map((l) => <li>{l}</li>)}
                </ol>
              </dd>
            </div>
          </dl>
        </div>

        <h3 class="mt-12 text-xl font-semibold text-[#0b1930]">{aboutCopy.operatingHeading}</h3>
        <p class="mt-4 text-base leading-relaxed text-[#334155]">{aboutCopy.operating}</p>
      </div>
    </section>
  )}

  {page === 'services' && (
    <section class="section">
      <div class="container-page space-y-16">
        {pillars.map((p, i) => (
          <article class="grid gap-8 border-b border-[#e2e5eb] pb-16 last:border-0 lg:grid-cols-3">
            <div>
              <p class="text-xs font-mono font-medium text-[#64748b]">0{i + 1}</p>
              <h2 class="mt-2 text-2xl font-semibold text-[#0b1930]">{p.title}</h2>
              <p class="mt-2 text-xs font-medium text-[#0b4ea2]">{p.tagline}</p>
            </div>
            <div class="lg:col-span-2">
              <p class="text-base leading-relaxed text-[#475569]">{p.desc}</p>
              <div class="mt-6 border-t border-[#e2e5eb] pt-6">
                <p class="category-tag text-xs font-semibold text-[#64748b] mb-4">
                  {locale === 'ar' ? 'المخرجات الفنية التعاقدية' : locale === 'ru' ? 'ПРОЕКТНЫЕ РЕЗУЛЬТАТЫ' : 'DELIVERABLES & SCOPE'}
                </p>
                <ul class="grid gap-3 sm:grid-cols-2">
                  {p.scope.map((s) => (
                    <li class="flex items-start gap-2 text-sm text-[#334155]">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-[#0b4ea2]"></span>
                      <span>{s}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {page === 'industries' && (
    <section class="section">
      <div class="container-page">
        <p class="max-w-3xl text-base leading-relaxed text-[#475569]">{INDUSTRIES_COPY.intro[locale]}</p>
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {sectors.map((s) => (
            <article class="card">
              <h2 class="text-lg font-semibold text-[#0b1930]">{s.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-[#475569]">{s.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {page === 'team' && (
    <section class="section">
      <div class="container-page">
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {teamMembers.map((member) => (
            <article class="card">
              <h2 class="text-lg font-semibold text-[#0b1930]">{member.name}</h2>
              <p class="mt-1 text-xs font-medium text-[#0b4ea2]">{member.role}</p>
              <p class="mt-4 text-xs leading-relaxed text-[#475569]">{member.bio}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {!['about', 'services', 'industries', 'team'].includes(page) && (
    <section class="section">
      <div class="container-page prose-tight max-w-3xl">
        <p>{t.description}</p>
      </div>
    </section>
  )}

  {['about', 'services', 'industries', 'team'].includes(page) && (
    <section class="border-t border-[#e2e5eb] bg-[#0b1930] text-white">
      <div class="container-page py-16 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-xl">
          <h2 class="text-2xl font-semibold text-white sm:text-3xl">{PAGES.contact[locale].title}</h2>
          <p class="mt-2 text-sm text-slate-300">
            {locale === 'ar'
              ? 'أرسل معايير مشروعك ونطاقه لنعد مقترح دعم فني منظم.'
              : locale === 'ru'
                ? 'Направьте нам параметры проекта для подготовки структурированного предложения.'
                : 'Send us your project parameters and scope to prepare a structured technical support proposal.'}
          </p>
        </div>
        <a href={localizedPath(locale, 'contact')} class="btn-primary shrink-0">
          {CTA_LABEL[locale]}
        </a>
      </div>
    </section>
  )}
</Base>
