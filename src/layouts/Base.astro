---
import '../styles/global.css';
import { LOCALES, LOCALE_META, SITE_URL, BRAND, type Locale } from '../i18n/config';
import { PAGES, localizedPath, type PageKey } from '../i18n/pages';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ANALYTICS, CUSTOMERIO } from '../i18n/config';

interface Props {
  locale: Locale;
  page: PageKey;
  image?: string;
  /** Per-page overrides (case studies, etc.). Fall back to the shared PAGES metadata. */
  title?: string;
  description?: string;
  /** Absolute path for the canonical URL, e.g. `/en/projects/en-pump-station`. */
  canonicalPath?: string;
  /** hreflang alternates keyed by locale → absolute path. Overrides the default page-level alternates. */
  altPaths?: Partial<Record<Locale, string>>;
}

const { locale, page, image, title, description, canonicalPath, altPaths } = Astro.props;
const meta = LOCALE_META[locale];
const t = PAGES[page][locale];
const dir = meta.dir;

const pageTitle = title ?? t.title;
const pageDescription = description ?? t.description;

const canonical = new URL((canonicalPath ?? localizedPath(locale, page)) + '/', SITE_URL).toString();
const ogImage = image ?? '/brand/og-default.png';

const SCHEMA_DESCRIPTIONS: Record<Locale, string> = {
  en: 'Engineering and project management consultancy based in Dubai (DIEZ), UAE, providing technical advisory and prospective architectural drawings.',
  ar: 'استشارات هندسية وإدارة مشاريع مقرها في دبي (دييز)، الإمارات، تقدم استشارات فنية ورسومات معمارية منظورية.',
  ru: 'Консалтинг в области инженерии и управления проектами в Дубае (DIEZ), ОАЭ, технический консалтинг и перспективные архитектурные чертежи.',
};

const SCHEMA_SERVICES: Record<Locale, string[]> = {
  en: ['Project Management', 'Technical Consultancy', 'Architectural Prospective Drawings', 'Management Consultancy'],
  ar: ['إدارة المشاريع', 'الاستشارات الفنية', 'الرسومات المعمارية المنظورية', 'الاستشارات الإدارية'],
  ru: ['Управление проектами', 'Технический консалтинг', 'Перспективные архитектурные чертежи', 'Управленческий консалтинг'],
};

// hreflang alternates for all locales, plus x-default.
const alternates = LOCALES.map((l) => ({
  hreflang: LOCALE_META[l].htmlLang,
  href: new URL((altPaths?.[l] ?? localizedPath(l, page)) + '/', SITE_URL).toString(),
}));
const xDefault = new URL((altPaths?.en ?? localizedPath('en', page)) + '/', SITE_URL).toString();
---

<!doctype html>
<html lang={meta.htmlLang} dir={dir} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="max-image-preview:large" />

    {/* Self-hosted font preloads: primary weights 400 and 600 per active script */}
    {locale === 'ar' ? (
      <>
        <link rel="preload" href="/fonts/ibm-plex-sans-arabic-400-1.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/ibm-plex-sans-arabic-600-9.woff2" as="font" type="font/woff2" crossorigin />
      </>
    ) : (
      <>
        <link rel="preload" href="/fonts/inter-400-18.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/inter-600-32.woff2" as="font" type="font/woff2" crossorigin />
      </>
    )}

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.htmlLang} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE_URL).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL(ogImage, SITE_URL).toString()} />
    <meta name="theme-color" content="#0b1930" />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {CUSTOMERIO.writeKey && <meta name="cio-write-key" content={CUSTOMERIO.writeKey} />}
    {page === 'home' && (
      <link rel="preload" as="image" href="/brand/power-plant-hero.webp" type="image/webp" fetchpriority="high" />
    )}
    <slot name="head" />

    {/* ── Local SEO: Organization + ProfessionalService JSON-LD ── */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${SITE_URL}/#organization`,
      "name": "ALAN AND APIRE MANAGEMENT CONSULTANCIES – FZCO",
      "alternateName": "Alanpire",
      "url": SITE_URL,
      "logo": `${SITE_URL}/brand/logo-mark.svg`,
      "image": `${SITE_URL}/brand/og-default.png`,
      "description": SCHEMA_DESCRIPTIONS[locale],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Dubai Integrated Economic Zones Authority (DIEZ)",
        "addressLocality": "Dubai",
        "addressCountry": "AE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 25.19850,
        "longitude": 55.27210
      },
      "areaServed": [
        { "@type": "Country", "name": "United Arab Emirates" }
      ],
      "email": "info@alanapire.ae",
      "telephone": "+971558286328",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "info@alanapire.ae",
        "telephone": "+971558286328",
        "contactType": "technical inquiry",
        "availableLanguage": ["English", "Arabic", "Russian"]
      },
      "knowsAbout": [
        "Project Management",
        "Technical Consultancy",
        "District Heating",
        "Boiler Plants",
        "Architectural Prospective Drawings"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Licensed Services",
        "itemListElement": SCHEMA_SERVICES[locale].map((s, idx) => ({
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": s
          },
          "position": idx + 1
        }))
      },
      "parentOrganization": {
        "@type": "GovernmentOrganization",
        "name": "Dubai Integrated Economic Zones Authority (DIEZ)"
      },
      "foundingLocation": {
        "@type": "Place",
        "name": "Dubai, UAE"
      },
      "sameAs": []
    })} />
  </head>
  <body class="min-h-dvh flex flex-col bg-[#faf9f6] text-[#0b1930]">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:start-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#0b1930] focus:text-white focus:rounded focus:text-sm focus:font-medium">
      {locale === 'ar' ? 'انتقل إلى المحتوى الرئيسي' : locale === 'ru' ? 'Перейти к основному содержанию' : 'Skip to main content'}
    </a>
    <Header locale={locale} page={page} />
    <main id="main" class="flex-1 pt-[var(--header-h)]">
      <slot />
    </main>
    <Footer locale={locale} />

    {ANALYTICS.provider === 'plausible' && (
      <script defer data-domain={ANALYTICS.domain} src="https://plausible.io/js/script.js"></script>
    )}
    <script>
      if (document.querySelector('meta[name="cio-write-key"]')?.getAttribute('content')) {
        import('../lib/customerio').then((m) => m.initCustomerIO());
      }
    </script>
    {ANALYTICS.provider === 'ga4' && ANALYTICS.measurementId && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.measurementId}`}></script>
    )}
    {ANALYTICS.provider === 'ga4' && ANALYTICS.measurementId && (
      <script is:inline define:vars={{ gaId: ANALYTICS.measurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}
  </body>
</html>
