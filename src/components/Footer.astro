---
import { type Locale } from '../i18n/config';
import { PAGES, PAGE_ORDER, localizedPath } from '../i18n/pages';
import { BRAND } from '../i18n/config';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const year = new Date().getFullYear();
const cols: { heading: string; items: { label: string; href: string }[] }[] = [
  {
    heading: PAGES.services[locale].label,
    items: PAGE_ORDER.filter((p) => ['services', 'industries', 'projects'].includes(p)).map((p) => ({
      label: PAGES[p][locale].label, href: localizedPath(locale, p),
    })),
  },
  {
    heading: PAGES.about[locale].label,
    items: PAGE_ORDER.filter((p) => ['about', 'team', 'careers'].includes(p)).map((p) => ({
      label: PAGES[p][locale].label, href: localizedPath(locale, p),
    })),
  },
];
---

<footer class="mt-auto border-t border-brand-100 bg-brand-950 text-brand-100">
  <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="flex items-center gap-2 font-serif text-lg font-bold text-white">
        <img src="/brand/logo-mark.svg" alt="" width="28" height="28" class="h-7 w-7" />
        <span>Alan Apire</span>
      </div>
      <p class="mt-3 text-sm text-brand-300">{BRAND.address[locale]}</p>
      <p class="mt-1 text-sm text-brand-300">{BRAND.email}</p>
      <p class="mt-1 text-sm text-brand-300" dir="ltr">{BRAND.phone}</p>
    </div>
    {cols.map((c) => (
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-accent">{c.heading}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {c.items.map((i) => <li><a href={i.href} class="text-brand-300 hover:text-white">{i.label}</a></li>)}
        </ul>
      </div>
    ))}
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-widest text-accent">{PAGES.contact[locale].label}</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={localizedPath(locale, 'contact')} class="text-brand-300 hover:text-white">{PAGES.contact[locale].label}</a></li>
        <li><a href={localizedPath(locale, 'privacy')} class="text-brand-300 hover:text-white">{PAGES.privacy[locale].label}</a></li>
        <li><a href={localizedPath(locale, 'terms')} class="text-brand-300 hover:text-white">{PAGES.terms[locale].label}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-brand-900">
    <div class="container-page py-4 text-xs text-brand-400">© {year} {BRAND.name}. All rights reserved.</div>
  </div>
</footer>
