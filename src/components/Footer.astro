---
import { BRAND, type Locale } from '../i18n/config';
import { PAGES, localizedPath } from '../i18n/pages';
import { PILLARS, SECTORS, FOOTER_COPY } from '../i18n/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const year = new Date().getFullYear();
const pillars = PILLARS[locale];
const sectors = SECTORS[locale];
const servicesHref = localizedPath(locale, 'services');
const industriesHref = localizedPath(locale, 'industries');
---

<footer class="mt-auto border-t border-brand-100 bg-brand-950 text-brand-100">
  <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="flex items-center gap-2 font-serif text-lg font-bold text-white">
        <img src="/brand/logo-mark.svg" alt="" width="28" height="28" class="h-7 w-7" />
        <span>{BRAND.shortName}</span>
      </div>
      <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-brand-200">{BRAND.name}</p>
      <p class="mt-2 text-sm text-brand-300">{BRAND.address[locale]}</p>
      <p class="mt-2 text-sm text-brand-300">{BRAND.email}</p>
    </div>
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-widest text-accent">{FOOTER_COPY.pillarsHeading[locale]}</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {pillars.map((p) => <li><a href={servicesHref} class="text-brand-300 hover:text-white">{p.title}</a></li>)}
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-widest text-accent">{FOOTER_COPY.sectorsHeading[locale]}</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {sectors.map((s) => <li><a href={industriesHref} class="text-brand-300 hover:text-white">{s.title}</a></li>)}
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-widest text-accent">{PAGES.contact[locale].label}</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={localizedPath(locale, 'contact')} class="text-brand-300 hover:text-white">{PAGES.contact[locale].label}</a></li>
        <li><a href={localizedPath(locale, 'privacy')} class="text-brand-300 hover:text-white">{PAGES.privacy[locale].label}</a></li>
        <li><a href={localizedPath(locale, 'terms')} class="text-brand-300 hover:text-white">{PAGES.terms[locale].label}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-brand-900">
    <div class="container-page py-4 text-xs text-brand-400">© {year} {BRAND.name}. All rights reserved.</div>
  </div>
</footer>
