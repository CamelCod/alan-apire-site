---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { BRAND, type Locale } from '../i18n/config';
import { PARTNER_COPY } from '../i18n/partner';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = PARTNER_COPY[locale];
const nameFile = resolve(process.cwd(),'content/licence-name-ar.txt');
const arabicLegalName = existsSync(nameFile) ? readFileSync(nameFile,'utf8').trim() : '[ARABIC NAME – TO CONFIRM]';
// Licence No. unverified in public portal; confirm against licence PDF and DUL QR before launch.
// Verify DUL is active before launch (licence is valid only with an active Dubai Unified Licence).
---
<footer class="border-t border-[#e2e5eb] bg-[#0b1930] text-slate-200">
  <div class="container-page py-12">
    <div class="flex flex-wrap items-start justify-between gap-8">
      <a href={`/${locale}/`} class="text-xl font-semibold text-white">Alanpire</a>
      <nav aria-label={c.nav.primary} class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
        {(['about','services','projects','partner','contact'] as const).map(key => <a class="underline-offset-4 hover:underline" href={`/${locale}/${key}/`}>{c.nav[key]}</a>)}
        <a href={`/${locale}/privacy/`} class="hover:underline">{c.form.privacy}</a>
        <a href={`/${locale}/terms/`} class="hover:underline">{c.terms}</a>
      </nav>
    </div>
    {locale === 'ar' && <p class="mt-8 text-sm">{arabicLegalName}</p>}
    <p class="mt-8 max-w-5xl text-sm leading-relaxed"><bdi dir="ltr">{c.footerPrefix}</bdi> {c.legalBoundary}</p>
    <div class="mt-6 flex flex-wrap gap-6 text-sm">
      <a class="underline" href={`mailto:${BRAND.email}`}><span>{c.emailLabel}: </span><bdi dir="ltr">{BRAND.email}</bdi></a>
      <a class="underline" href={`tel:${BRAND.phone}`}><span>{c.phoneLabel}: </span><bdi dir="ltr">{BRAND.phone}</bdi></a>
    </div>
    <p class="mt-8 text-sm">© {new Date().getFullYear()} Alanpire. {c.rights}</p>
  </div>
</footer>
