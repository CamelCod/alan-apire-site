---
interface Props { title: string; eyebrow?: string; subtitle?: string; }
const { title, eyebrow, subtitle } = Astro.props;
---
<section class="bg-brand-900 text-white">
  <div class="container-page py-16 sm:py-20">
    {eyebrow && <p class="eyebrow text-accent">{eyebrow}</p>}
    <h1 class="mt-2 text-3xl sm:text-4xl lg:text-5xl">{title}</h1>
    {subtitle && <p class="mt-4 max-w-2xl text-brand-200">{subtitle}</p>}
  </div>
</section>
