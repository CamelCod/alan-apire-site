---
interface Props { title: string; eyebrow?: string; subtitle?: string; }
const { title, eyebrow, subtitle } = Astro.props;
---
<section class="border-b border-[#e2e5eb] bg-[#faf9f6] py-16 sm:py-20">
  <div class="container-page max-w-4xl">
    {eyebrow && <p class="category-tag text-xs font-semibold text-[#64748b]">{eyebrow}</p>}
    <h1 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#0b1930] leading-tight">{title}</h1>
    {subtitle && <p class="mt-4 text-base sm:text-lg text-[#475569] leading-relaxed">{subtitle}</p>}
  </div>
</section>
