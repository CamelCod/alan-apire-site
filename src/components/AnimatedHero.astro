---
interface Props {
  title: string
  eyebrow?: string
  subtitle?: string
  backgroundImage?: string
}
const { title, eyebrow, subtitle, backgroundImage = '/brand/power-plant-hero.jpg' } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-950">
  {/* Background image with fade animation */}
  <div class="absolute inset-0 opacity-0 animate-fadeIn">
    <img
      src={backgroundImage}
      alt="Hero background"
      class="h-full w-full object-cover"
    />
  </div>

  {/* Light/glow effect overlay */}
  <div class="absolute inset-0 opacity-0 animate-glowIn bg-gradient-to-br from-accent/30 via-transparent to-brand-950/80" />

  {/* Dark overlay for text readability */}
  <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/50 to-brand-950/30" />

  {/* Content with staggered animations */}
  <div class="container-page relative z-10 py-20 sm:py-28 lg:py-36">
    {eyebrow && (
      <p class="eyebrow animate-slideUp text-accent opacity-0 [animation-delay:200ms]">
        {eyebrow}
      </p>
    )}
    <h1 class="mt-4 animate-slideUp text-4xl sm:text-5xl lg:text-6xl text-white opacity-0 [animation-delay:400ms]">
      {title}
    </h1>
    {subtitle && (
      <p class="mt-6 animate-slideUp max-w-3xl text-lg sm:text-xl text-brand-100 opacity-0 [animation-delay:600ms]">
        {subtitle}
      </p>
    )}
    <div class="mt-10 animate-slideUp opacity-0 [animation-delay:800ms]">
      <a href="#projects" class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 font-semibold text-brand-950 transition-all hover:bg-accent-light hover:shadow-lg">
        Explore Projects
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes glowIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeIn {
    animation: fadeIn 1.2s ease-out forwards;
  }

  .animate-glowIn {
    animation: glowIn 1.5s ease-out forwards;
  }

  .animate-slideUp {
    animation: slideUp 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  /* Responsive text scaling */
  @media (max-width: 640px) {
    :global(section h1) {
      font-size: 1.875rem;
    }
  }
</style>
