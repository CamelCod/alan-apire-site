---
interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  backgroundImage?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title,
  eyebrow,
  subtitle,
  backgroundImage = '/brand/power-plant-hero.webp',
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="relative overflow-hidden bg-[#0b1930] text-white">
  {/* Background image with neutral contrast */}
  <div class="absolute inset-0 opacity-40">
    <picture>
      <source srcset={backgroundImage} type="image/webp" />
      <img
        src="/brand/power-plant-hero.jpg"
        alt=""
        aria-hidden="true"
        width="1102"
        height="820"
        fetchpriority="high"
        loading="eager"
        class="h-full w-full object-cover"
      />
    </picture>
  </div>

  {/* Neutral dark overlay for clean editorial readability — no gradient */}
  <div class="absolute inset-0 bg-[#0b1930]/65" />

  {/* Content */}
  <div class="container-page relative z-10 py-20 sm:py-28 lg:py-36">
    {eyebrow && (
      <p class="category-tag text-xs font-semibold text-slate-300">
        {eyebrow}
      </p>
    )}
    <h1 class="mt-4 text-3xl sm:text-5xl lg:text-6xl font-semibold text-white max-w-4xl leading-tight">
      {title}
    </h1>
    {subtitle && (
      <p class="mt-6 max-w-3xl text-base sm:text-lg text-slate-200 leading-relaxed">
        {subtitle}
      </p>
    )}
    <div class="mt-10 flex flex-wrap items-center gap-4">
      {primaryLabel && primaryHref && (
        <a href={primaryHref} class="btn-primary">
          <span>{primaryLabel}</span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1 rtl:rotate-180">→</span>
        </a>
      )}
      {secondaryLabel && secondaryHref && (
        <a href={secondaryHref} class="btn-outline border-white/30 bg-transparent text-white hover:bg-white/10">
          {secondaryLabel}
        </a>
      )}
    </div>
  </div>
</section>
