---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/config';
import { PARTNER_COPY } from '../i18n/partner';
import { isPublishedCase } from '../lib/case-publication';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = PARTNER_COPY[locale];
const cases = (await getCollection('projects', entry => entry.data.locale === locale && isPublishedCase(entry.data))).sort((a,b) => a.data.order - b.data.order);
---
{cases.length ? <div class="mt-8 grid gap-8 md:grid-cols-2">
  {cases.map(entry => <article data-case-id={entry.data.translationKey} class="overflow-hidden border border-[#e2e5eb] bg-white">
    {entry.data.coverUrl && <figure>
      <img src={entry.data.coverUrl} alt={entry.data.coverAlt ?? ''} width="400" height="225" loading="lazy" decoding="async" class="mx-auto h-auto w-full max-w-[400px]" />
      <figcaption class="p-4 text-sm text-[#475569]">{c.illustrative}</figcaption>
    </figure>}
    {!entry.data.coverUrl && entry.data.cover && <figure>
      <Image src={entry.data.cover} alt={entry.data.coverAlt ?? entry.data.title} widths={[320,400]} sizes="(max-width:440px) calc(100vw - 40px), 400px" format="webp" loading="lazy" class="mx-auto h-auto w-full max-w-[400px]" />
      <figcaption class="p-4 text-sm text-[#475569]">{c.illustrative}</figcaption>
    </figure>}
    <div class="p-6">
      <h3>{entry.data.title}</h3>
      <p class="mt-3 text-[#475569]">{entry.data.summary}</p>
      <p class="mt-3 text-sm">{c.scopeLabel}: {entry.data.scope}</p>
      <p class="mt-3 text-sm">{c.roleLabel}: {entry.data.role}</p>
      {entry.data.year && <p class="mt-3 text-sm">{entry.data.location} · {c.yearLabel}: <bdi>{entry.data.year}</bdi></p>}
      <p class="mt-4 text-sm text-[#475569]">{c.attribution}</p>
      <a class="mt-5 inline-block font-medium text-[#0b4ea2] underline" href={`/${locale}/projects/${entry.slug}/`}>{c.experienceLink}: {entry.data.title}</a>
    </div>
  </article>)}
</div> : <p class="mt-6 max-w-3xl border-s-4 border-[#0b4ea2] bg-white p-6 text-[#475569]">{c.doneNote}</p>}
