---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { PROJECTS_COPY } from '../../../i18n/site';

export const getStaticPaths = (async () => {
  // Only verified case studies are published; placeholders carry order 99.
  const projects = await getCollection('projects', (e) => e.data.order < 99);
  return projects.map((p) => ({
    params: { locale: p.data.locale, slug: p.slug },
    props: { project: p },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const locale = project.data.locale;
const d = project.data;

// Build hreflang alternates across locales for the same case study (via translationKey).
const siblings = await getCollection('projects', (e) => e.data.translationKey === d.translationKey);
const altPaths = Object.fromEntries(
  siblings.map((s) => [s.data.locale, `/${s.data.locale}/projects/${s.slug}`])
);

// Localized labels for the project meta strip.
const META_LABELS: Record<string, { sector: string; service: string; year: string; location: string; published: string; updated: string }> = {
  en: { sector: 'Sector', service: 'Service', year: 'Year', location: 'Location', published: 'Published', updated: 'Updated' },
  ru: { sector: 'Направление', service: 'Услуга', year: 'Год', location: 'Локация', published: 'Опубликовано', updated: 'Обновлено' },
  ar: { sector: 'القطاع', service: 'الخدمة', year: 'السنة', location: 'الموقع', published: 'نُشر', updated: 'تم التحديث' },
};
const L = META_LABELS[locale] ?? META_LABELS.en;
---

<Base
  locale={locale}
  page="projects"
  image={d.cover?.src}
  title={d.title}
  description={d.summary}
  canonicalPath={`/${locale}/projects/${project.slug}`}
  altPaths={altPaths}
>
  <PageHero eyebrow={d.sector ?? ''} title={d.title} subtitle={d.summary} />

  <section class="section">
    <div class="container-page max-w-3xl">
      <!-- Cover image slot. Drop an image into frontmatter `cover:` to replace the placeholder. -->
      <figure class="mb-10">
        {d.cover ? (
          <img src={d.cover.src} alt={d.title} width={d.cover.width} height={d.cover.height} class="w-full rounded-lg object-cover aspect-video" />
        ) : (
          <div
            class="flex aspect-video w-full flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-brand-200 bg-brand-50 text-brand-400"
            role="img"
            aria-label="Project image placeholder"
          >
            <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <path d="m21 15-5-5L5 21" />
            </svg>
            <span class="text-xs font-medium uppercase tracking-widest">Image coming soon</span>
          </div>
        )}
      </figure>

      <!-- Project meta strip -->
      {(d.sector || d.service || d.year || d.location || d.datePublished || d.dateModified) && (
        <dl class="mb-10 grid grid-cols-2 gap-4 rounded-lg border border-brand-100 bg-white p-6 sm:grid-cols-4">
          {d.sector && <div><dt class="eyebrow text-[0.65rem]">{L.sector}</dt><dd class="mt-1 text-sm font-semibold text-brand-800">{d.sector}</dd></div>}
          {d.service && <div><dt class="eyebrow text-[0.65rem]">{L.service}</dt><dd class="mt-1 text-sm font-semibold text-brand-800">{d.service}</dd></div>}
          {d.year && <div><dt class="eyebrow text-[0.65rem]">{L.year}</dt><dd class="mt-1 text-sm font-semibold text-brand-800">{d.year}</dd></div>}
          {d.location && <div><dt class="eyebrow text-[0.65rem]">{L.location}</dt><dd class="mt-1 text-sm font-semibold text-brand-800">{d.location}</dd></div>}
          {d.datePublished && <div><dt class="eyebrow text-[0.65rem]">{L.published}</dt><dd class="mt-1 text-sm font-semibold text-brand-800">{d.datePublished}</dd></div>}
          {d.dateModified && <div><dt class="eyebrow text-[0.65rem]">{L.updated}</dt><dd class="mt-1 text-sm font-semibold text-brand-800">{d.dateModified}</dd></div>}
        </dl>
      )}

      <div class="prose-tight">
        <Content />
      </div>

      <!-- Mandated attribution & confidentiality disclosure -->
      <p class="mt-12 rounded-lg border border-brand-100 bg-brand-50 p-4 text-xs text-brand-500">
        {PROJECTS_COPY.disclosure[locale]}
      </p>
    </div>
  </section>
</Base>
