---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import { PROJECTS_COPY } from '../../../i18n/site';

export const getStaticPaths = (async () => {
  // Only verified case studies are published; placeholders carry order 99.
  const projects = await getCollection('projects', (e) => e.data.order < 99);
  return projects.map((p) => ({
    params: { locale: p.data.locale, slug: p.slug },
    props: { project: p },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const locale = project.data.locale;
const d = project.data;

// Build hreflang alternates across locales for the same case study (via translationKey).
const siblings = await getCollection('projects', (e) => e.data.translationKey === d.translationKey);
const altPaths = Object.fromEntries(
  siblings.map((s) => [s.data.locale, `/${s.data.locale}/projects/${s.slug}`])
);

// Editorial Labels per locale
const LABELS = {
  en: {
    back: '← Back to projects',
    factStrip: 'Project Fact Strip',
    attributionHeading: 'Mandatory Project Attribution',
    contactHeading: 'Discuss a similar package',
    contactSub: 'Our engineers review route alignments, sizing criteria, and hydraulic parameters for industrial infrastructure.',
    contactBtn: 'Discuss your project',
    assetNeeded: 'Asset required: Route alignment drawing',
  },
  ar: {
    back: '→ العودة إلى المشاريع',
    factStrip: 'شريط بيانات المشروع',
    attributionHeading: 'إقرار نسبة المشروع الإلزامي',
    contactHeading: 'ناقش حزمة مماثلة',
    contactSub: 'يراجع مهندسونا مسارات الخطوط ومعايير الأبعاد والمعاملات الهيدروليكية للبنية التحتية الصناعية.',
    contactBtn: 'ناقش مشروعك',
    assetNeeded: 'الأصل المطلوب: مخطط محاذاة المسار',
  },
  ru: {
    back: '← Назад к проектам',
    factStrip: 'Основные параметры объекта',
    attributionHeading: 'Обязательное указание авторства',
    contactHeading: 'Обсудить аналогичный объем',
    contactSub: 'Наши специалисты оценят расчетные параметры, трассировку сетей и состав проектной документации.',
    contactBtn: 'Обсудить проект',
    assetNeeded: 'Требуемый материал: трассировка сетей',
  },
}[locale];
---

<Base
  locale={locale}
  page="projects"
  image={d.cover?.src}
  title={`${d.title} | Alanpire`}
  description={d.summary}
  canonicalPath={`/${locale}/projects/${project.slug}`}
  altPaths={altPaths}
>
  {/* 1. Full-Width Editorial Hero with Category Label and Project Name */}
  <section class="border-b border-[#e2e5eb] bg-[#faf9f6] pt-12 pb-16">
    <div class="container-page">
      <a href={`/${locale}/projects/`} class="text-xs font-semibold text-[#0b4ea2] hover:underline mb-6 inline-block">
        {LABELS.back}
      </a>
      <p class="category-tag text-xs font-semibold text-[#64748b]">
        {d.editorialLabel ?? d.sector}
      </p>
      <h1 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#0b1930] max-w-4xl leading-tight">
        {d.title}
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#475569] max-w-3xl leading-relaxed">
        {d.supportLine ?? d.summary}
      </p>

      {/* Hero Image / Drawing Area */}
      <figure class="mt-10 overflow-hidden border border-[#e2e5eb] bg-white">
        {d.cover ? (
          <Image
            src={d.cover}
            alt={d.coverAlt ?? d.title}
            widths={[480, 768, 1200]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 1200px"
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
            class="w-full aspect-[16/10] sm:aspect-[21/9] object-cover"
          />
        ) : (
          /* Deliberate Text-Led Layout for Missing Asset */
          <div class="aspect-[16/10] sm:aspect-[21/9] p-8 sm:p-12 flex flex-col justify-between bg-[#faf9f6]">
            <div>
              <p class="category-tag">{d.editorialLabel ?? d.sector}</p>
              <div class="mt-4 flex flex-wrap gap-8 text-[#0b1930]">
                {d.figures?.map((fig) => (
                  <div>
                    <span class="text-2xl sm:text-4xl font-bold tracking-tight block">{fig}</span>
                  </div>
                ))}
              </div>
            </div>
            <p class="text-xs text-[#94a3b8] italic">
              {d.missingAssetNote ?? LABELS.assetNeeded}
            </p>
          </div>
        )}
        {d.coverCaption && <figcaption class="p-4 text-sm leading-relaxed text-[#475569]">{d.coverCaption}</figcaption>}
      </figure>
    </div>
  </section>

  {/* Main Case Study Body */}
  <section class="section">
    <div class="container-page max-w-4xl">
      {/* 2. Fact Strip */}
      <div class="mb-12 border border-[#e2e5eb] bg-white p-6 sm:p-8">
        <p class="category-tag text-xs font-semibold text-[#64748b] mb-4">
          {LABELS.factStrip}
        </p>
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-xs">
          {d.location && (
            <div>
              <dt class="text-[#64748b]">{locale === 'ar' ? 'الموقع' : locale === 'ru' ? 'Локация' : 'Location'}</dt>
              <dd class="mt-1 font-semibold text-[#0b1930]">{d.location}</dd>
            </div>
          )}
          {d.year && (
            <div>
              <dt class="text-[#64748b]">{locale === 'ar' ? 'الجدول الزمني' : locale === 'ru' ? 'Сроки' : 'Timeline'}</dt>
              <dd class="mt-1 font-semibold text-[#0b1930]">{d.year}</dd>
            </div>
          )}
          {d.service && (
            <div>
              <dt class="text-[#64748b]">{locale === 'ar' ? 'نطاق الخدمة' : locale === 'ru' ? 'Услуга' : 'Service Scope'}</dt>
              <dd class="mt-1 font-semibold text-[#0b1930]">{d.service}</dd>
            </div>
          )}
          {d.figures && d.figures[0] && (
            <div>
              <dt class="text-[#64748b]">{locale === 'ar' ? 'المقياس الرئيسي' : locale === 'ru' ? 'Основной параметр' : 'Key Scale'}</dt>
              <dd class="mt-1 font-semibold text-[#0b4ea2]">{d.figures[0]}</dd>
            </div>
          )}
        </dl>
      </div>

      {/* 3–6. Markdown Content: Intro, Contribution, Drawing excerpt, Approval Record */}
      <div class="prose-tight space-y-6 text-[#334155]">
        <Content />
      </div>

      {/* 7. Attribution Block (Mandatory) */}
      <div class="mt-12 border-l-4 border-[#0b1930] bg-white p-6 border border-[#e2e5eb]">
        <p class="category-tag text-xs font-semibold text-[#64748b]">
          {LABELS.attributionHeading}
        </p>
        <p class="mt-2 text-xs leading-relaxed text-[#475569]">
          {PROJECTS_COPY.disclosure[locale]}
        </p>
      </div>

      {/* 8. Contact Prompt */}
      <div class="mt-10 border border-[#e2e5eb] bg-[#faf9f6] p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <div>
          <h3 class="text-lg font-semibold text-[#0b1930]">{LABELS.contactHeading}</h3>
          <p class="mt-1 text-xs text-[#64748b] max-w-xl leading-relaxed">{LABELS.contactSub}</p>
        </div>
        <a href={`/${locale}/contact/`} class="btn-primary shrink-0 self-start sm:self-center">
          {LABELS.contactBtn}
        </a>
      </div>
    </div>
  </section>
</Base>
