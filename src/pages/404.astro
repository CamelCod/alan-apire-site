---
// Cloudflare Pages + Netlify both serve src/pages/404.astro as the custom 404 page.
// This page is NOT locale-scoped intentionally — we detect the browser language
// and offer the correct locale link, but keep the layout locale-neutral to avoid
// redirects on error paths (which Google does NOT render JS for).
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { BRAND, SITE_URL } from '../i18n/config';
---

<!doctype html>
<html lang="en" dir="ltr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Page Not Found — {BRAND.name}</title>
    <meta name="description" content="The page you were looking for could not be found. Return to the Alan Apire homepage." />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <Header locale="en" page="home" />
    <main id="main" class="flex-1 pt-[var(--header-h)] flex items-center justify-center">
      <section class="container-page py-24 text-center">

        <p class="text-[7rem] font-bold leading-none text-brand-100 select-none" aria-hidden="true">404</p>

        <h1 class="text-2xl font-bold text-brand-900 mt-2 mb-3">
          Page not found
        </h1>
        <p class="text-brand-600 max-w-md mx-auto mb-8">
          The page you were looking for doesn’t exist or has been moved.
          Try one of the links below.
        </p>

        <nav aria-label="404 recovery links" class="flex flex-wrap gap-3 justify-center">
          <a href="/en/" class="btn-primary">
            Go to homepage
          </a>
          <a href="/en/services/" class="btn-outline">
            Our services
          </a>
          <a href="/en/contact/" class="btn-outline">
            Contact us
          </a>
        </nav>

        <div class="mt-12 flex flex-wrap gap-6 justify-center text-sm text-brand-500">
          <a href="/ar/" class="hover:text-brand-700 hover:underline" lang="ar" dir="rtl">الصفحة الرئيسية</a>
          <a href="/ru/" class="hover:text-brand-700 hover:underline" lang="ru">Главная страница</a>
        </div>

      </section>
    </main>
    <Footer locale="en" />
    <WhatsAppButton locale="en" />
  </body>
</html>
