# Canonical production URL (used by astro.config `site` and canonical/hreflang URLs)
ASTRO_SITE=https://alanapire.ae

# Formspree — create a form at https://formspree.io and paste the endpoint
FORMSPREE_ENDPOINT=https://formspree.io/f/your-id

# Analytics (optional). Leave unset to ship with no third-party analytics script.
# ANALYTICS_PROVIDER=plausible
# PLAUSIBLE_DOMAIN=alanapire.ae
# ANALYTICS_PROVIDER=ga4
# GA4_MEASUREMENT_ID=G-XXXXXXXX
